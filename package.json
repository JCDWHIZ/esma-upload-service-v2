{
  "name": "esma-upload-service-v2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "lint": "eslint \"{src,apps,libs,test,tests}/**/*.ts\" --fix",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:reference": "vitest run --project reference",
    "test:contract": "vitest run --project contract",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:jest": "jest",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "env:example": "ts-node scripts/generate-env-example.ts",
    "env:check": "ts-node scripts/generate-env-example.ts --check",
    "secret:scan": "ts-node scripts/scan-secrets.ts",
    "audit": "pnpm audit --prod --audit-level=high",
    "db:migrate": "node dist/src/db/migrate.js migrate",
    "db:status": "node dist/src/db/migrate.js status",
    "apikey:create": "ts-node src/scripts/apikey-cli.ts create",
    "apikey:revoke": "ts-node src/scripts/apikey-cli.ts revoke",
    "apikey:list": "ts-node src/scripts/apikey-cli.ts list",
    "apikey:create:prod": "node dist/src/scripts/apikey-cli.js create",
    "apikey:revoke:prod": "node dist/src/scripts/apikey-cli.js revoke",
    "apikey:list:prod": "node dist/src/scripts/apikey-cli.js list",
    "reconcile:orphans": "ts-node src/scripts/reconcile-orphans.ts",
    "reconcile:orphans:prod": "node dist/src/scripts/reconcile-orphans.js",
    "dlq:list": "ts-node src/scripts/dlq-cli.ts list",
    "dlq:redrive": "ts-node src/scripts/dlq-cli.ts redrive",
    "dlq:discard": "ts-node src/scripts/dlq-cli.ts discard",
    "dlq:stats": "ts-node src/scripts/dlq-cli.ts stats",
    "dlq:list:prod": "node dist/src/scripts/dlq-cli.js list",
    "dlq:redrive:prod": "node dist/src/scripts/dlq-cli.js redrive",
    "dlq:discard:prod": "node dist/src/scripts/dlq-cli.js discard",
    "dlq:stats:prod": "node dist/src/scripts/dlq-cli.js stats",
    "storage:promote": "ts-node src/scripts/storage-promote-cli.ts",
    "storage:promote:prod": "node dist/src/scripts/storage-promote-cli.js",
    "file:hard-delete": "ts-node src/scripts/hard-delete-cli.ts",
    "file:hard-delete:prod": "node dist/src/scripts/hard-delete-cli.js",
    "perf:fixtures": "ts-node tests/perf/generate-fixtures.ts",
    "test:perf": "vitest run --project perf",
    "test:chaos": "vitest run --project chaos",
    "test:security": "vitest run --project security"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@confluentinc/kafka-javascript": "^1.10.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "cloudinary": "^2.11.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "uuid": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.10.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!.*(kysely|jose))"
    ],
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@10.15.0"
}
