{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:esma:events:file.uploaded.v1.schema.json",
  "title": "FileUploadedEventV1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "organizationId",
    "producer",
    "actor",
    "data"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "file.uploaded.v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "organizationId": { "type": "string" },
    "producer": { "type": "string", "const": "esma-upload-service" },
    "traceId": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["USER", "SERVICE", "SYSTEM"] },
        "id": { "type": "string" },
        "actingService": { "type": ["string", "null"] }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "fileId",
        "namespace",
        "filename",
        "mimetype",
        "size",
        "sha256",
        "visibility",
        "scanStatus"
      ],
      "properties": {
        "fileId": { "type": "string" },
        "namespace": { "type": "string" },
        "filename": { "type": "string" },
        "mimetype": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "visibility": { "type": "string", "enum": ["private", "tenant", "public"] },
        "scanStatus": { "type": "string", "enum": ["PENDING", "CLEAN", "INFECTED", "ERROR", "SKIPPED"] },
        "attributes": { "type": "object" },
        "retainUntil": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
