{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:esma:events:files.tenant.exported.v1.schema.json",
  "title": "FilesTenantExportedEventV1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "organizationId",
    "producer",
    "actor",
    "data"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "files.tenant.exported.v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "organizationId": { "type": "string" },
    "producer": { "type": "string", "const": "esma-upload-service" },
    "traceId": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["USER", "SERVICE", "SYSTEM"] },
        "id": { "type": "string" },
        "actingService": { "type": ["string", "null"] }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "requestId",
        "bundleFileId",
        "files",
        "bytes"
      ],
      "properties": {
        "requestId": { "type": "string" },
        "bundleFileId": { "type": "string" },
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
