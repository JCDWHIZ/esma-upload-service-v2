{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Volume (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gus_http_requests_total[5m])) by (method, route, status_code)",
          "legendFormat": "{{method}} {{route}} ({{status_code}})"
        }
      ]
    },
    {
      "title": "Upload Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gus_upload_failures_total[5m])) / sum(rate(gus_http_requests_total{route=\"/api/v1/files/upload\"}[5m])) * 100",
          "legendFormat": "Error Rate %"
        }
      ]
    },
    {
      "title": "Upload Latency p50 / p95 / p99 (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gus_upload_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gus_upload_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gus_upload_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Upload Payload Bandwidth (Bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(gus_upload_bytes_total[5m])) by (namespace, provider)",
          "legendFormat": "{{namespace}} - {{provider}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["esma", "gus", "api"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "ESMA GUS - API Overview",
